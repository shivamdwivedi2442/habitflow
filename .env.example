#  Engineered by Shivam Coder (https://github.com/shivamdwivedi2442)
# 1. Node.js / Express Server Configuration
HOST=0.0.0.0
PORT=8000

# 2. PostgreSQL / Supabase Connection (Optional for local dev; auto-falls back to embedded store if blank)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. Nodemailer SMTP Configuration for Signup & Login 6-Digit OTP Emails
# (If left blank in local dev, the server automatically logs and previews the 6-digit OTP on screen)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-google-app-password
SMTP_FROM="HabitFlow by Shivam Coder <no-reply@habitflow.dev>"

# 4. High-Security Auth & Session Signing Settings
APP_SECRET_KEY=replace-with-a-64-char-random-cryptographic-secret-in-production
TOKEN_EXPIRY_SECONDS=604800

# 5. Default Fallback Time Zone (IANA format)
DEFAULT_TIMEZONE=Asia/Kolkata

# 6. React Native (Expo) Public API Endpoint
EXPO_PUBLIC_API_URL=http://localhost:8000

# 7. Google Gemini Pro AI Assistant Key (For Natural Language Add / Done / Edit / Delete)
GEMINI_API_KEY=your-google-gemini-pro-api-key
GEMINI_MODEL=gemini-1.5-pro
